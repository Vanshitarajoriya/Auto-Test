# Copy to .env (never commit it). The agent never reads .env; Playwright loads it for the tests.
DEV_URL=https://<dev-host>            # MSG91 DEV base URL (unknown yet: ask the dev team)
ALLOWED_HOSTS=<dev-host>              # live hosts (control.msg91.com etc.) are always refused, even if listed
MSG91_AUTHKEY=                        # authkey of the dedicated automation account on DEV
AUTH_HEADER=authkey
TEST_RECIPIENTS=<test number with country code, no +>,<test inbox email>
MAX_MESSAGES_PER_RUN=20
WORKERS=1                             # keep 1 for tests that send messages (the spend cap is per worker)

# Dashboard login for UI tests (automation account only)
TEST_EMAIL=
TEST_PASSWORD=
LOGIN_PATH=/login
EMAIL_SELECTOR=input[type=email]
PASSWORD_SELECTOR=input[type=password]
SUBMIT_SELECTOR=button[type=submit]
LOGGED_IN_SELECTOR=                   # something only visible after login, e.g. [data-testid=user-menu]
