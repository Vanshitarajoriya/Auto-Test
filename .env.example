# Copy to .env (never commit .env). In CI these come from repository secrets.
DEV_URL=https://<dev-host>
ALLOWED_HOSTS=<dev-host>            # set explicitly in CI; live hosts are always refused
MSG91_AUTHKEY=<authkey of the dedicated automation account on dev>
AUTH_HEADER=authkey
TEST_RECIPIENTS=<our test number>,<our test inbox>
MAX_MESSAGES_PER_RUN=20
WORKERS=1

# Dashboard login for UI tests (automation account only). Selectors are for tests/_seed/seed.spec.mjs
TEST_EMAIL=
TEST_PASSWORD=
LOGIN_PATH=/login
EMAIL_SELECTOR=input[type=email]
PASSWORD_SELECTOR=input[type=password]
SUBMIT_SELECTOR=button[type=submit]
LOGGED_IN_SELECTOR=          # something only visible after login, e.g. [data-testid=user-menu]

# ClickUp (REST personal token, used by runner/run-card.mjs)
CLICKUP_TOKEN=
CLICKUP_MODULE_FIELD=Module
CLICKUP_FEATURE_FIELD=Feature
STATUS_PASSED="QA Passed"
STATUS_FAILED="QA Failed"
STATUS_BLOCKED=
CLICKUP_BUG_LIST_ID=

# Hosted server (npm start, server/index.mjs). Set these as secrets on the host, never in Git.
POST_STATUS=false             # week 1 is comment-only; true also moves the card
CREATE_BUGS=false             # true also creates a bug card per failed test
