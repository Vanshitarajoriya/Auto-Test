{
  "name": "msg91-qa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MSG91 QA agent: Claude Code reads a ClickUp card, writes and runs Playwright tests on DEV, judges the result from real evidence and reports on the card.",
  "scripts": {
    "selftest": "playwright test --project=selftest",
    "canary": "playwright test --project=canary",
    "test": "playwright test --project=api --project=ui",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "preflight": "node scripts/preflight.mjs",
    "seed": "playwright test --project=seed",
    "codegen": "playwright codegen",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.8"
  }
}
